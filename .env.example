# Values prefixed with PUBLIC_ may be included in browser resources.
# Keep this template free of credentials and payment IDs.
PUBLIC_SITE_URL=https://stonebatch.pages.dev
PUBLIC_CHECKOUT_URL=
PUBLIC_CURRENCY=EUR
PUBLIC_PRICE_CENTS=990

# Server-only Pages Functions configuration. Configure real Test values only in
# the Cloudflare Preview environment; never expose these variables to the browser.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRODUCT_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_ENV=

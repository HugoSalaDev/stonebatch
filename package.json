{
  "name": "stonebatch",
  "version": "0.1.0",
  "private": true,
  "description": "Static landing and preview deployment for StoneBatch.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "pages:dev": "wrangler pages dev --local-protocol=https",
    "pages:deploy:preview": "wrangler pages deploy --branch preview",
    "pages:deploy:production": "wrangler pages deploy --branch main"
  },
  "devDependencies": {
    "@fontsource/montserrat": "4.5.14",
    "@types/node": "24.10.1",
    "@types/opentype.js": "1.3.10",
    "@xmldom/xmldom": "0.9.12",
    "astro": "7.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "opentype.js": "2.0.0"
  }
}

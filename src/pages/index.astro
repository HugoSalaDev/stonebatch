---
import '../styles/global.css';

const title = 'StoneBatch — SS10 rhinestone name templates';
const description = 'Prepare batches of SS10 rhinestone name templates for Cricut.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <main class="page-shell">
      <p class="eyebrow">StoneBatch preview</p>
      <h1>SS10 rhinestone name templates, made for batches.</h1>
      <p class="lead">
        StoneBatch is a browser-based tool for preparing multiple names and numbers as Cricut-ready
        rhinestone templates.
      </p>
      <section aria-labelledby="preview-status">
        <h2 id="preview-status">Preview environment</h2>
        <p>
          The initial project and deployment are ready for validation. Template entry, generation and
          downloads are not available yet.
        </p>
      </section>
      <section aria-labelledby="planned-output">
        <h2 id="planned-output">Planned output</h2>
        <ul>
          <li>Names and numbers prepared in a single batch.</li>
          <li>SS10 rhinestone templates for Cricut workflows.</li>
          <li>Files generated locally in the browser.</li>
        </ul>
      </section>
      <p class="notice">This preview is intentionally not indexed by search engines.</p>
    </main>
  </body>
</html>
